      "PropertyInspectorPath": "property-inspector/inspector.html",
      "UUID": "io.github.1mentat.agentdeck.ulanzi.overview",
      "States": [{ "Image": "resources/overview.svg" }],
      "SupportedInMultiActions": false,
      "Controllers": ["Keypad"]
    },
    {
      "Name": "Needs You",
      "Tooltip": "Shows the highest-priority Codex thread waiting for input or approval.",
      "Icon": "resources/needs-you.svg",
      "PropertyInspectorPath": "property-inspector/inspector.html",
      "UUID": "io.github.1mentat.agentdeck.ulanzi.needsyou",
      "States": [{ "Image": "resources/needs-you.svg" }],
      "SupportedInMultiActions": false,
      "Controllers": ["Keypad"]
    },
    {
      "Name": "Agent Slot",
