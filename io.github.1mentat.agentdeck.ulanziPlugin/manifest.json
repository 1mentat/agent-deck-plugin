      "PropertyInspectorPath": "property-inspector/inspector.html",
      "UUID": "io.github.1mentat.agentdeck.ulanzi.recent",
      "States": [{ "Image": "resources/recent.svg" }],
      "SupportedInMultiActions": false,
      "Controllers": ["Keypad"]
