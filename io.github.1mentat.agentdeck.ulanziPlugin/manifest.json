      "PropertyInspectorPath": "property-inspector/inspector.html",
      "UUID": "io.github.1mentat.agentdeck.ulanzi.agentslot",
      "States": [{ "Image": "resources/agent.svg" }],
      "SupportedInMultiActions": false,
      "Controllers": ["Keypad"]
    },
    {
      "Name": "Recent Completion",
      "Tooltip": "Shows the most recently completed Codex task.",
